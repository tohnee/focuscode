{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cache-epoch.v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "modelRevision",
    "toolBundleHash",
    "systemHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cache-epoch.v1",
      "type": "string"
    },
    "modelRevision": {
      "minLength": 1,
      "type": "string"
    },
    "chatTemplateHash": {
      "type": "string"
    },
    "toolBundleHash": {
      "minLength": 1,
      "type": "string"
    },
    "systemHash": {
      "minLength": 1,
      "type": "string"
    },
    "reasoningProtocol": {
      "type": "string"
    },
    "toolProtocol": {
      "type": "string"
    },
    "cacheMode": {
      "type": "string"
    }
  }
}
