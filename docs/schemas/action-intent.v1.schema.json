{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "action-intent.v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "actionId",
    "taskId",
    "tool",
    "arguments",
    "expectedEffects",
    "justification"
  ],
  "properties": {
    "schemaVersion": {
      "const": "action-intent.v1",
      "type": "string"
    },
    "actionId": {
      "minLength": 1,
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "type": "string"
    },
    "tool": {
      "additionalProperties": false,
      "type": "object",
      "required": ["id", "version", "schemaDigest"],
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        },
        "schemaDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      }
    },
    "arguments": {},
    "expectedEffects": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["class", "description"],
        "properties": {
          "class": {
            "anyOf": [
              {
                "const": "read",
                "type": "string"
              },
              {
                "const": "file_write",
                "type": "string"
              },
              {
                "const": "command",
                "type": "string"
              },
              {
                "const": "network",
                "type": "string"
              },
              {
                "const": "secret",
                "type": "string"
              },
              {
                "const": "git",
                "type": "string"
              },
              {
                "const": "delegation",
                "type": "string"
              }
            ]
          },
          "resource": {
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "justification": {
      "minLength": 1,
      "type": "string"
    },
    "baseState": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    }
  }
}
